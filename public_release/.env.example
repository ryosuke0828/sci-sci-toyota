# Copy this file to .env and fill in the values. reproduce.ipynb reads .env.
# You can also export the variables in your shell instead.

# Contact e-mail sent to OpenAlex (optional; requests with a contact address get more stable responses)
SCISCI_CONTACT_EMAIL=

# Scopus API key (only needed to rerun step 6, src/enrich_papers_scopus.py)
SCOPUS_API_KEY=
